model Order {
  id              String   @id @default(cuid())
 datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}ipeSessionId String   @unique
  items           Json
  total           Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}
